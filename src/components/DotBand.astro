---
// A strip of pointillist dots, like the painted borders Seurat put around his canvases.
// Generated at build time from a seed so it's stable between renders and needs no JS.

type Props = {
	seed?: number;
	height?: number;
	class?: string;
};

const { seed = 1, height = 20, class: className } = Astro.props;

const WIDTH = 1200;
const STEP = 5.5;
// Weighted so sea green and pale sky dominate; coral is a rare accent.
const COLORS = [
	...Array(5).fill('sky'),
	...Array(4).fill('sea'),
	...Array(3).fill('foam'),
	...Array(3).fill('mist'),
	'blue',
	'blue',
	'sand',
	'lavender',
	'sea-deep',
];
const CORAL_ODDS = 0.015;

function mulberry32(a: number) {
	return () => {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(seed);
const dots = [];
for (let y = STEP / 2; y < height; y += STEP * 0.75) {
	for (let x = (rand() * STEP) / 2; x < WIDTH; x += STEP) {
		dots.push({
			cx: (x + (rand() - 0.5) * STEP * 0.8).toFixed(1),
			cy: (y + (rand() - 0.5) * STEP * 0.6).toFixed(1),
			r: (1 + rand() * 1.1).toFixed(1),
			color: rand() < CORAL_ODDS ? 'coral' : COLORS[Math.floor(rand() * COLORS.length)],
			twinkle: rand() < 0.1,
			delay: (rand() * 4).toFixed(2),
		});
	}
}
---

<svg
	class:list={['dot-band', className]}
	viewBox={`0 0 ${WIDTH} ${height}`}
	preserveAspectRatio="xMidYMid slice"
	style={`height: ${height}px`}
	aria-hidden="true"
	focusable="false"
>
	{
		dots.map((d) => (
			<circle
				cx={d.cx}
				cy={d.cy}
				r={d.r}
				class:list={[d.color, { tw: d.twinkle }]}
				style={d.twinkle ? `animation-delay: -${d.delay}s` : undefined}
			/>
		))
	}
</svg>

<style>
	.dot-band {
		display: block;
		width: 100%;
	}

	.sky { fill: var(--sky); }
	.mist { fill: var(--mist); }
	.sea { fill: var(--sea); }
	.sea-deep { fill: var(--sea-deep); }
	.foam { fill: var(--foam); }
	.blue { fill: var(--blue); }
	.sand { fill: var(--sand); }
	.lavender { fill: var(--lavender); }
	.coral { fill: var(--coral); }

	.tw {
		transform-box: fill-box;
		transform-origin: center;
		animation: twinkle 3.6s ease-in-out infinite;
	}

	@keyframes twinkle {
		50% {
			transform: scale(1.6);
			opacity: 0.6;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tw {
			animation: none;
		}
	}

	/* In the paint themes, each dot becomes a short daub of paint */
	circle {
		transform-box: fill-box;
		transform-origin: center;
	}

	:global(:root[data-medium='paint']) circle {
		animation: none;
		transform: rotate(-24deg) scale(2.3, 0.8);
	}

	:global(:root[data-medium='paint']) circle:nth-child(3n) {
		transform: rotate(18deg) scale(2.1, 0.8);
	}

	:global(:root[data-medium='paint']) circle:nth-child(5n) {
		transform: rotate(-60deg) scale(1.9, 0.85);
	}
</style>
