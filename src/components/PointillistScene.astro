---
// A little harbor painted in dots, after Seurat's Port-en-Bessin, Entrance to the Harbor (1888).
// Dots scatter away from the pointer and spring back home; a click sends a ripple.
---

<figure class="scene">
	<div class="frame">
		<canvas aria-hidden="true"></canvas>
	</div>
	<figcaption>
		<em>Entrance to the Harbor, Port-en-Bessin</em> · after Seurat, 1888
		<span class="hint">· wave through the dots, or give them a poke</span>
	</figcaption>
</figure>

<style>
	.scene {
		margin: 0 0 2.25rem;
	}

	.frame {
		/* Seurat painted dotted borders around his canvases; this one is CSS. */
		border: 7px solid transparent;
		border-radius: 16px;
		background:
			linear-gradient(var(--paper), var(--paper)) padding-box,
			radial-gradient(circle, var(--sea) 1.1px, transparent 1.6px) 0 0 / 5px 5px border-box,
			radial-gradient(circle, var(--mist) 1.1px, transparent 1.6px) 2px 3px / 7px 6px border-box,
			radial-gradient(circle, var(--blue) 1px, transparent 1.5px) 4px 1px / 9px 8px border-box,
			radial-gradient(circle, var(--sand) 1px, transparent 1.5px) 1px 4px / 11px 9px border-box,
			var(--canvas) border-box;
		box-shadow: 0 10px 30px -18px rgba(38, 33, 71, 0.45);
		transform: rotate(-0.6deg);
		overflow: hidden;
	}

	canvas {
		display: block;
		width: 100%;
		height: clamp(190px, 34vw, 270px);
		border-radius: 9px;
		cursor: crosshair;
		touch-action: pan-y;
	}

	figcaption {
		margin-top: 0.7rem;
		font-size: 0.9rem;
		color: var(--muted);
		text-align: center;
	}

	figcaption em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--text);
	}

	@media (max-width: 520px) {
		.hint {
			display: block;
		}
	}
</style>

<script>
	import { paintInDots, type Painter } from '../lib/pointillism';

	// Shadows of passing clouds on the water, the painting's signature dark patches.
	// u/rx are fractions of width, v/ry of height.
	const CLOUD_SHADOWS = [
		{ u: 0.52, v: 0.78, rx: 0.2, ry: 0.07 },
		{ u: 0.84, v: 0.9, rx: 0.16, ry: 0.06 },
		{ u: 0.4, v: 0.6, rx: 0.1, ry: 0.035 },
		{ u: 0.7, v: 0.64, rx: 0.08, ry: 0.03 },
	];

	const BOATS = [
		{ u: 0.28, v: 0.46, size: 0.12, sail: 'white' },
		{ u: 0.44, v: 0.5, size: 0.16, sail: 'coral' },
		{ u: 0.6, v: 0.62, size: 0.22, sail: 'white' },
	];

	const harbor: Painter = (x, y, { w, h, P, fleck }) => {
		const u = x / w;
		const v = y / h;
		const horizon = 0.36;

		// Sailboats: a triangular sail over a small dark hull
		for (const b of BOATS) {
			const bx = w * b.u;
			const by = h * b.v;
			const s = h * b.size;
			if (y < by && y > by - s * 1.6) {
				const t = (y - (by - s * 1.6)) / (s * 1.6);
				if (x > bx - s * 0.05 && x < bx + s * 0.95 * t)
					return b.sail === 'coral'
						? fleck([P.coral, P.coral, P.sand], [P.cream], 0.15)
						: fleck([P.white, P.white, P.cream], [P.sand], 0.1);
			}
			if (y >= by && y < by + s * 0.22 && Math.abs(x - (bx + s * 0.3)) < s * 0.55)
				return fleck([P.blueDeep, P.ink], [P.sand], 0.1);
		}

		// The jetty reaching in from the right, with a little light at its tip
		const jettyY = h * 0.5;
		const jettyTip = w * 0.74;
		if (x > jettyTip && Math.abs(y - jettyY) < h * 0.035)
			return fleck([P.lavenderDeep, P.sand, P.lavenderDeep, P.blueDeep], [P.coral], 0.08);
		if (x > jettyTip && y > jettyY && y < jettyY + h * 0.06 && Math.round(x / 9) % 3 === 0)
			return fleck([P.lavenderDeep, P.ink], [P.sand], 0.1);
		if (Math.abs(x - (jettyTip + h * 0.04)) < h * 0.025 && y > jettyY - h * 0.16 && y < jettyY)
			return y < jettyY - h * 0.12 ? fleck([P.coral, P.sand], [P.cream], 0.2) : fleck([P.cream, P.sand], [P.lavender], 0.15);

		// The grassy embankment curving in from the lower left
		const bankEdge = w * (0.04 + 0.34 * Math.pow(Math.max(0, (v - 0.58) / 0.42), 0.7));
		if (v > 0.58 && x < bankEdge) {
			if (x > bankEdge - h * 0.05) return fleck([P.sand, P.cream], [P.lavender], 0.15);
			return fleck([P.sea, P.seaDeep, P.foam], [P.sand, P.lavender], 0.15);
		}

		// Sky
		if (v < horizon) return fleck([P.sky, P.sky, P.cream, P.mist], [P.lavender, P.sand], 0.1);

		// Cloud shadows on the water
		for (const c of CLOUD_SHADOWS) {
			const dx = (u - c.u) / c.rx;
			const dy = (v - c.v) / c.ry;
			const wobble = 1 + 0.15 * Math.sin(u * 40 + c.v * 10);
			if (dx * dx + dy * dy < wobble) return fleck([P.sea, P.blue, P.sea], [P.lavender, P.coral], 0.12);
		}

		// Sea: a band of deeper color at the horizon, paler and greener toward us
		if (v < horizon + 0.06) return fleck([P.blue, P.sea, P.mist], [P.lavender], 0.1);
		return fleck([P.foam, P.sky, P.foam, P.mist], [P.sand, P.lavender], 0.1);
	};

	document.querySelectorAll<HTMLCanvasElement>('.scene canvas').forEach((canvas) => paintInDots(canvas, harbor));
</script>
