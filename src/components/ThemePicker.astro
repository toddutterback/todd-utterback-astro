---
// "Painted after: Seurat · Signac · ..." Picking an artist recolors the site and repaints every
// painting in their brushwork. The choice is remembered on this device. Only shown when more than
// one theme is enabled in src/lib/themes.ts.
import { ENABLED_THEMES } from '../lib/themes';
---

{ENABLED_THEMES.length > 1 && (
<div class="picker" role="group" aria-label="Paint the site after">
	<span class="label">Painted after</span>
	<div class="options">
		{
			ENABLED_THEMES.map((t) => (
				<button type="button" class="option" data-theme-id={t.id} title={`${t.artist}, ${t.years}`}>
					<span class="swatch" aria-hidden="true">
						<i style={`background: ${t.palette.sea}`} />
						<i style={`background: ${t.palette.sky}`} />
						<i style={`background: ${t.palette.coral}`} />
					</span>
					{t.artist}
				</button>
			))
		}
	</div>
</div>
)}

<style>
	.picker {
		max-width: var(--max);
		margin: 0 auto;
		padding: 1.5rem max(1rem, env(safe-area-inset-right)) 0 max(1rem, env(safe-area-inset-left));
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.label {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.options {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem;
	}

	.option {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.75rem 0.3rem 0.5rem;
		border: 1.5px dashed var(--border);
		border-radius: 999px;
		background: var(--paper);
		color: var(--muted);
		font: inherit;
		font-size: 0.88rem;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.option:hover {
		transform: rotate(-3deg) scale(1.05);
		color: var(--text);
	}

	.option[aria-pressed='true'] {
		border-style: solid;
		border-color: var(--sea-deep);
		color: var(--text);
	}

	.swatch {
		position: relative;
		width: 20px;
		height: 16px;
		flex: none;
	}

	.swatch i {
		position: absolute;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
	}

	.swatch i:nth-child(1) {
		left: 0;
		top: 3px;
	}

	.swatch i:nth-child(2) {
		left: 6px;
		top: 0;
	}

	.swatch i:nth-child(3) {
		left: 10px;
		top: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		.option:hover {
			transform: none;
		}
	}
</style>

<script>
	import { applyTheme, THEME_EVENT, THEME_STORAGE_KEY, currentTheme } from '../lib/themes';

	const buttons = document.querySelectorAll<HTMLButtonElement>('.picker .option');

	const tagline = document.getElementById('tagline');

	function sync() {
		const theme = currentTheme();
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeId === theme.id)));
		if (tagline) tagline.textContent = theme.tagline;
	}

	buttons.forEach((b) =>
		b.addEventListener('click', () => {
			const id = b.dataset.themeId!;
			applyTheme(id);
			try {
				localStorage.setItem(THEME_STORAGE_KEY, id);
			} catch {}
			sync();
			window.dispatchEvent(new CustomEvent(THEME_EVENT, { detail: id }));
		}),
	);

	sync();
</script>
