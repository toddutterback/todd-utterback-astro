---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Painting from '../../components/Painting.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
	const posts = await getCollection('thoughts', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
	title={`${post.data.title} — ${SITE.name}`}
	description={post.data.description ?? SITE.description}
>
	<article class="prose">
		<p class="back"><a href="/thoughts">← Thoughts</a></p>
		<Painting painting={post.slug} height="200px" virtualWidth={380} step={4} tilt="0.4deg" />
		<h1>{post.data.title}</h1>
		{post.data.description ? <p class="subtitle">{post.data.description}</p> : null}
		<Content />
	</article>
</Layout>

<style>
	.back {
		margin-bottom: 1.5rem;
	}

	.back a {
		text-decoration: none;
		color: var(--muted);
		font-weight: 700;
	}

	.back a:hover {
		text-decoration: underline;
		color: var(--text);
	}

	.subtitle {
		color: var(--muted);
		margin-top: -0.25rem;
	}

	.prose {
		max-width: 70ch;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.2rem;
	}

	.prose :global(li) {
		margin: 0.25rem 0;
	}

	.prose :global(hr) {
		border: 0;
		height: 6px;
		margin: 2.25rem auto;
		width: 5rem;
		background:
			radial-gradient(circle, var(--sea) 2.2px, transparent 2.7px) 0 0 / 12px 6px repeat-x,
			radial-gradient(circle, var(--mist) 2.2px, transparent 2.7px) 6px 0 / 12px 6px repeat-x;
	}

	.prose :global(blockquote) {
		margin: 1.75rem 0;
		padding: 0.9rem 1.1rem 0.9rem 1.6rem;
		border-radius: 0 14px 14px 0;
		color: var(--muted);
		font-style: italic;
		/* A column of dabs instead of a rule. */
		background:
			radial-gradient(circle, var(--sea) 2px, transparent 2.5px) 0 3px / 8px 8px repeat-y,
			radial-gradient(circle, var(--mist) 1.7px, transparent 2.2px) 3px 7px / 8px 10px repeat-y,
			rgba(255, 250, 240, 0.7);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}
</style>

