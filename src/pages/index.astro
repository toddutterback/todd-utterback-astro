---
import Layout from '../layouts/Layout.astro';
import Painting from '../components/Painting.astro';
import PaintedCards from '../components/PaintedCards.astro';
import { publishedThoughts, thoughtCard } from '../lib/thoughts';

// An even number keeps the two-column card grid tidy.
const RECENT_THOUGHTS = 4;

const recentThoughts = (await publishedThoughts()).slice(0, RECENT_THOUGHTS);
---

<Layout>
	<Painting painting="harbor">
		<em>Entrance to the Harbor, Port-en-Bessin</em> · after Seurat, 1888
		<span class="hint">· wave through the dots, or give them a poke</span>
	</Painting>
	<h1>Hi 👋 I’m Todd Utterback</h1>
	<p>
		I’m a software engineering leader, currently the Director of Engineering at SixFifty, a legal tech startup. 
	</p>	
	<p>
		
		I care about building durable teams, software, and systems.
	</p>
	<p>
		This site is a small collection of notes and essays on engineering, leadership, and life. That sounds big, but this is just me doing some thinking in public.
	</p>

	<section class="recent" aria-labelledby="recent-thoughts-heading">
		<h2 id="recent-thoughts-heading">Recent thoughts</h2>
		{recentThoughts.length === 0 ? <p class="muted">Nothing here yet.</p> : <PaintedCards items={recentThoughts.map(thoughtCard)} />}
		<p class="more">
			<a href="/thoughts">All thoughts</a>
		</p>
	</section>

	<p>
		If you want more context: <a href="/about">About</a>.
	</p>
</Layout>

<style>
	.recent {
		margin: 2.25rem 0 1.5rem;
	}

	.recent h2 {
		margin-bottom: 0;
	}

	.more {
		margin: 1.5rem 0 0;
		text-align: right;
	}

	.more a {
		font-weight: 700;
	}
</style>
